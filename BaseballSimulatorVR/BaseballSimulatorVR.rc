            VALUE "OriginalFilename", "BaseballSimulatorVR.exe"
            VALUE "ProductName", "BaseballSimulatorVR"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
